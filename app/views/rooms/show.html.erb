<h1>施設詳細</h1>

<div>
  <% if @room.image.attached? %>
    <%= image_tag @room.image, width: 300, height: 200 %>
  <% else %>
    <%= image_tag "default_room.png", width: 300, height: 200 %>
  <% end %>

  <h2><%= @room.name %></h2>

  <p>施設詳細：<%= @room.description %></p>

  <p>料金：<%= @room.price %>円</p>

  <% if current_user == @room.user %>
    <%= link_to "編集", edit_room_path(@room) %>

    <div data-controller="delete-modal">
      <button
        type="button"
        data-action="click->delete-modal#open">
        削除
      </button>

      <div
        id="delete-room-modal"
        data-delete-modal-target="modal"
        style="display: none;">

        <h2>施設を削除しますか？</h2>

        <% if @room.image.attached? %>
          <%= image_tag @room.image, width: 200, height: 150 %>
        <% else %>
          <%= image_tag "default_room.png", width: 200, height: 150 %>
        <% end %>

        <h3><%= @room.name %></h3>
        <p>料金：<%= @room.price %>円</p>

        <%= button_to "削除する", room_path(@room), method: :delete %>

        <button
          type="button"
          data-action="click->delete-modal#close">
          キャンセル
        </button>
      </div>
    </div>
  <% end %>

  <%= link_to "施設一覧に戻る", rooms_path %>
</div>
