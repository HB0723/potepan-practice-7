<div class="room-show-container">

  <div class="room-show-back">
    <%= link_to "← 戻る", search_rooms_path %>
  </div>

  <div class="room-show-layout">

    <div class="room-show-image">
      <% if @room.image.attached? %>
        <%= image_tag @room.image %>
      <% else %>
        <%= image_tag "default_room.png" %>
      <% end %>
    </div>

    <div class="room-show-panel">

      <div class="room-show-heading">
        <div>
          <h1><%= @room.name %></h1>

          <p class="room-show-address">
            <%= @room.address %>
          </p>
        </div>

        <p class="room-show-price">
          ¥<%= number_with_delimiter(@room.price) %>〜
        </p>
      </div>


      <div class="room-show-description">
        <%= simple_format(@room.description) %>
      </div>

  <div class="room-reservation-box">

    <% if @reservation.errors.any? %>
      <div class="reservation-errors">
        <p>予約情報を確認してください。</p>
      </div>
    <% end %>

    <%= form_with model: @reservation,
                url: reservations_confirm_path,
                method: :post,
                data: { turbo: false },
                class: "room-reservation-form" do |f| %>

      <%= hidden_field_tag :room_id, @room.id %>

      <div class="reservation-fields">

          <div class="reservation-field">
            <%= f.label :checkin_at, "チェックイン" %>

            <%= f.date_field :checkin_at,
              min: Date.current,
              class: "reservation-input" %>

            <% @reservation.errors.full_messages_for(:checkin_at).each do |message| %>
              <p class="field-error"><%= message %></p>
            <% end %>
        </div>


        <div class="reservation-field">
          <%= f.label :checkout_at, "チェックアウト" %>

          <%= f.date_field :checkout_at,
              min: Date.current,
              class: "reservation-input" %>

          <% @reservation.errors.full_messages_for(:checkout_at).each do |message| %>
            <p class="field-error"><%= message %></p>
          <% end %>
        </div>


        <div class="reservation-field">
          <%= f.label :guest_count, "人数" %>

          <%= f.number_field :guest_count,
              min: 1,
              placeholder: "1",
              class: "reservation-input" %>

          <% @reservation.errors.full_messages_for(:guest_count).each do |message| %>
            <p class="field-error"><%= message %></p>
          <% end %>
        </div>

      </div>


      <%= f.submit @rebooking ? "再予約する" : "予約する",
            class: "room-reservation-button" %>

    <% end %>
  </div>

      <% if current_user == @room.user %>
        <div class="room-owner-actions">

          <%= link_to "施設を編集する",
                edit_room_path(@room),
                class: "room-edit-button" %>


          <div data-controller="delete-modal">

            <button
              type="button"
              class="room-delete-button"
              data-action="click->delete-modal#open">
              施設を削除する
            </button>


            <div
              class="delete-modal"
              data-delete-modal-target="modal"
              style="display: none;">

              <div class="delete-modal-content">

                <h2>施設を削除しますか？</h2>

                <% if @room.image.attached? %>
                  <%= image_tag @room.image, class: "delete-modal-image" %>
                <% else %>
                  <%= image_tag "default_room.png", class: "delete-modal-image" %>
                <% end %>

                <h3><%= @room.name %></h3>

                <p>
                  住所：<%= @room.address %>
                </p>

                <p>
                  ¥<%= number_with_delimiter(@room.price) %>〜
                </p>

                <div class="delete-modal-actions">

                  <%= button_to "削除する",
                        room_path(@room),
                        method: :delete,
                        class: "delete-confirm-button" %>

                  <button
                    type="button"
                    class="delete-cancel-button"
                    data-action="click->delete-modal#close">
                    キャンセル
                  </button>

                </div>

              </div>
            </div>

          </div>
        </div>
      <% end %>

    </div>

  </div>
</div>
