<h1>施設を検索</h1>

<%= form_with url: search_rooms_path, method: :get do |f| %>

  <div>
    <%= f.label :area, "エリア" %>
    <%= f.select :area,
      [
        ["指定なし", ""],
        ["東京", "東京"],
        ["大阪", "大阪"],
        ["京都", "京都"],
        ["札幌", "札幌"]
      ]
    %>
  </div>

  <div>
    <%= f.label :keyword, "フリーワード" %>
    <%= f.text_field :keyword, placeholder: "施設名・施設詳細" %>
  </div>

  <div>
    <%= f.submit "検索" %>
  </div>

<% end %>

<h2>検索結果</h2>

<p>検索結果：<%= @rooms.count %>件</p>

<% @rooms.each do |room| %>
  <div>
    <% if room.image.attached? %>
      <%= image_tag room.image, width: 150, height: 100 %>
    <% else %>
      <%= image_tag "default_room.png", width: 150, height: 100 %>
    <% end %>

    <h3>
      <%= link_to room.name, room_path(room) %>
    </h3>

    <p>施設詳細：<%= room.description %></p>
    <p>料金：<%= room.price %>円</p>
    <p>住所：<%= room.address %></p>
  </div>
<% end %>

<%= link_to "自分の施設一覧", rooms_path %>
