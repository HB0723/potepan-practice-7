<div class="auth-page">
  <div class="auth-card">

    <h1 class="auth-title">新規登録</h1>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name)) do |f| %>

      <div class="auth-field">
        <%= f.label :name do %>
          ユーザー名 <span class="auth-required">*</span>
        <% end %>

        <%= f.text_field :name,
              autofocus: true,
              placeholder: "ユーザー名を入力",
              class: "auth-input" %>

        <% resource.errors.full_messages_for(:name).each do |message| %>
          <p class="auth-error"><%= message %></p>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :email do %>
          メールアドレス <span class="auth-required">*</span>
        <% end %>

        <%= f.email_field :email,
              autocomplete: "email",
              placeholder: "メールアドレスを入力",
              class: "auth-input" %>

        <% resource.errors.full_messages_for(:email).each do |message| %>
          <p class="auth-error"><%= message %></p>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password do %>
          パスワード <span class="auth-required">*</span>
        <% end %>

        <%= f.password_field :password,
              autocomplete: "new-password",
              placeholder: "パスワードを入力",
              class: "auth-input" %>

        <% resource.errors.full_messages_for(:password).each do |message| %>
          <p class="auth-error"><%= message %></p>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation do %>
          確認用パスワード <span class="auth-required">*</span>
        <% end %>

        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "確認用パスワードを入力",
              class: "auth-input" %>

        <% resource.errors.full_messages_for(:password_confirmation).each do |message| %>
          <p class="auth-error"><%= message %></p>
        <% end %>
      </div>


      <%= f.submit "新しいアカウントを作成",
            class: "auth-submit" %>

    <% end %>

    <%= link_to "アカウントをお持ちの方はログイン",
          new_user_session_path,
          class: "auth-secondary-button" %>

  </div>
</div>
