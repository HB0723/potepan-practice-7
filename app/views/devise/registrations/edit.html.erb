<h1>アカウント情報編集</h1>

<%= form_for(resource,
             as: resource_name,
             url: registration_path(resource_name),
             html: { method: :put }) do |f| %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email, "メールアドレス" %></p>
    <p>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email" %>
    </p>
  </div>

  <div class="field">
    <p><%= f.label :password, "新しいパスワード" %></p>
    <p>変更しない場合は空欄のままにしてください</p>

    <p>
      <%= f.password_field :password,
            autocomplete: "new-password" %>
    </p>

    <% if @minimum_password_length %>
      <p>
        <%= @minimum_password_length %>文字以上
      </p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "新しいパスワード（確認）" %></p>

    <p>
      <%= f.password_field :password_confirmation,
            autocomplete: "new-password" %>
    </p>
  </div>

  <div class="field">
    <p><%= f.label :current_password, "現在のパスワード" %></p>
    <p>変更を保存するために現在のパスワードを入力してください</p>

    <p>
      <%= f.password_field :current_password,
            autocomplete: "current-password" %>
    </p>
  </div>

  <div class="actions">
    <%= f.submit "更新する" %>
  </div>

<% end %>

<p>
  <%= link_to "アカウント設定に戻る", users_account_path %>
</p>
