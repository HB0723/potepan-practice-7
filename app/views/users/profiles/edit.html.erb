<div class="settings-container">

  <h1 class="settings-page-title">設定</h1>

  <div class="settings-layout">

    <%= render "users/settings_sidebar" %>

    <div class="settings-main">

      <div class="settings-heading">
        <h2>プロフィール</h2>
      </div>

      <%= form_with model: @user,
                    url: users_profiles_path,
                    method: :patch,
                    html: { multipart: true },
                    class: "settings-form" do |f| %>

        <div class="settings-form-row">
          <div class="settings-form-label">
            アイコン画像
          </div>

          <div class="settings-profile-image-edit">
            <% if @user.icon.attached? %>
              <%= image_tag @user.icon,
                    class: "settings-profile-icon" %>
            <% else %>
              <%= image_tag "default_icon.png",
                    class: "settings-profile-icon" %>
            <% end %>

            <label class="settings-upload-button">
              画像アップロード

              <%= f.file_field :icon,
                    accept: "image/*",
                    class: "settings-file-input" %>
            </label>
          </div>
        </div>


        <div class="settings-form-row">
          <%= f.label :name,
                "名前",
                class: "settings-form-label" %>

          <%= f.text_field :name,
                class: "settings-form-input" %>
        </div>


        <div class="settings-form-row">
          <%= f.label :self_introduction,
                "自己紹介",
                class: "settings-form-label" %>

          <%= f.text_area :self_introduction,
                placeholder: "自己紹介を入力",
                class: "settings-form-textarea" %>
        </div>


        <div class="settings-form-actions">
          <%= link_to "キャンセル",
                users_profile_path,
                class: "settings-cancel-button" %>

          <%= f.submit "保存",
                class: "settings-save-button" %>
        </div>

      <% end %>

    </div>

  </div>
</div>
