<h1>プロフィール編集</h1>

<% if @user.icon.attached? %>
  <%= image_tag @user.icon, width: 100, height: 100 %>
<% else %>
  <%= image_tag "default_icon.png", width: 100, height: 100 %>
<% end %>

<%= form_with model: @user, url: users_profiles_path, method: :patch, html: { multipart: true } do |f| %>

  <div>
    <%= f.label :icon, "アイコン" %>
    <%= f.file_field :icon %>
  </div>

  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :self_introduction, "自己紹介" %>
    <%= f.text_area :self_introduction %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>

<% end %>
