<h1>宿泊予約</h1>

<% if @reservation.errors.any? %>
  <div>
    <h2>入力内容を確認してください</h2>

    <ul>
      <% @reservation.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<h2><%= @room.name %></h2>

<% if @room.image.attached? %>
  <%= image_tag @room.image, width: 300, height: 200 %>
<% else %>
  <%= image_tag "default_room.png", width: 300, height: 200 %>
<% end %>

<p>料金：<%= @room.price %>円</p>
<p>住所：<%= @room.address %></p>

<%= form_with model: @reservation, url: reservations_confirm_path, method: :post, data: { turbo: false } do |f| %>

  <div>
    <%= f.label :checkin_at, "チェックイン日" %>
    <%= f.date_field :checkin_at, min: Date.current %>
  </div>

  <div>
    <%= f.label :checkout_at, "チェックアウト日" %>
    <%= f.date_field :checkout_at, min: Date.current %>
  </div>

  <div>
    <%= f.label :guest_count, "宿泊人数" %>
    <%= f.number_field :guest_count, min: 1 %>
  </div>

  <%= hidden_field_tag :room_id, @room.id %>

  <div>
    <%= f.submit "予約内容を確認する" %>
  </div>

<% end %>
